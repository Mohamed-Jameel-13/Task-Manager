{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.6.0"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|images|fonts|assets)/(.*)",
      "dest": "public/$1/$2"
    },
    {
      "src": "/(.*)\\.(.+)",
      "dest": "public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  }
}
