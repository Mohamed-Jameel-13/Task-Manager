{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    { "src": "/(css|js|images|fonts|favicon|build)/(.*)", "dest": "public/$1/$2" },
    { "src": "/favicon.ico", "dest": "public/favicon.ico" },
    { "src": "/robots.txt", "dest": "public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_NAME": "Task Manager",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://task-manager-vercel.vercel.app",
    "APP_KEY": "base64:JT+DhYrz/heCTsLh5M5+5yMRO9b2zOgE+89p7Lrne9g=",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "CACHE_DRIVER": "file",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "none"
  },
  "buildCommand": "php artisan migrate --force && npm run build",
  "outputDirectory": "."
}
