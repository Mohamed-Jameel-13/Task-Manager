{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0",
      "excludeFiles": "{public/**,resources/**}"
    }
  },
  "routes": [
    { "src": "/(css|js|images|fonts|favicon|build)/(.*)", "dest": "public/$1/$2" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "public/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_NAME": "Task Manager",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://task-manager-vercel.vercel.app",
    "APP_KEY": "base64:JT+DhYrz/heCTsLh5M5+5yMRO9b2zOgE+89p7Lrne9g=",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "CACHE_DRIVER": "file",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "none"
  },
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "."
}
