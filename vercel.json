{
  "version": 2,
  "framework": "laravel",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.6.0"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|images|fonts|assets|build)/(.*)",
      "dest": "public/$1/$2"
    },
    {
      "src": "/(.*)\\.(.+)",
      "dest": "public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "npm run build && chmod +x vercel-build.sh && ./vercel-build.sh"
}
